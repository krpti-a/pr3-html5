{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false, "noImplicitAny": false, "useDefineForClassFields": false, "allowImportingTsExtensions": true,
    "noEmit": true, "skipLibCheck": true, "noImplicitOverride": false
  },
  "include": ["src/**/*.ts"]
}
